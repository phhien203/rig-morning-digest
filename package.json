    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
